{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter bracken-docs build",
  "outputDirectory": "docs/out",
  "redirects": [
    {
      "source": "/",
      "destination": "/introduction",
      "permanent": false
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
